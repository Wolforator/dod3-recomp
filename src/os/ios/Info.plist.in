<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iOS app's Info.plist (CMakeLists.txt, MACOSX_BUNDLE_INFO_PLIST). -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <!-- the name under the icon (Home Screen, LiveContainer's list): 12
         characters, the most a Home Screen shows without cutting it -->
    <key>CFBundleName</key><string>Drakengard 3</string>
    <key>CFBundleDisplayName</key><string>Drakengard 3</string>
    <!-- the icon: tools/make_icon.py's drawing (an original, no game art),
         AppIcon60x60@2x.png and @3x.png beside the executable, which
         tools/ios/package_ipa.sh puts there (no asset catalog: no Xcode) -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array>
            <key>CFBundleIconName</key><string>AppIcon</string>
            <key>UIPrerenderedIcon</key><true/>
        </dict>
    </dict>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key><string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>MinimumOSVersion</key><string>17.0</string>
    <key>UIDeviceFamily</key><array><integer>1</integer></array>
    <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string><string>metal</string></array>
    <key>UILaunchScreen</key><dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <!-- Documents in the Files app: the game is copied in there -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- landscape, full screen -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
    </array>
    <key>UIRequiresFullScreen</key><true/>
    <!-- ProMotion: up to 120 Hz (an iPhone app is held to 60 without it);
         the frame rate itself is dod3.ini's DOD3_FPS -->
    <key>CADisableMinimumFrameDurationOnPhone</key><true/>
    <key>UIStatusBarHidden</key><true/>
    <key>UIViewControllerBasedStatusBarAppearance</key><false/>
    <key>GCSupportsControllerUserInteraction</key><true/>
    <key>GCSupportedGameControllers</key>
    <array>
        <dict><key>ProfileName</key><string>ExtendedGamepad</string></dict>
    </array>
    <key>UIBackgroundModes</key><array/>
</dict>
</plist>
